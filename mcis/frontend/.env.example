# Copy to .env (Create React App only reads REACT_APP_* vars, and only
# at build time -- changing these requires a rebuild, not just a
# restart). No secret values are present here.

# Where the frontend sends API requests. Both names are read in
# different files (src/App.js uses REACT_APP_API_URL,
# src/KnowledgeGraphPanel.js/src/NotificationsPanel.js use
# REACT_APP_BACKEND_URL) -- set both to the same backend URL.
REACT_APP_API_URL=http://localhost:5000
REACT_APP_BACKEND_URL=http://localhost:5000

# Firebase web app config (from your Firebase project's web app
# settings) -- used for client-side sign-in only; this is the public
# web config Firebase expects to ship to the browser, not a secret.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=
