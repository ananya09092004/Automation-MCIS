# MCIS / Nexus backend — environment TEMPLATE (names only, no values).
# Copy to .env (git-ignored) and fill in. Full reference: docs/PRODUCTION_CONFIG.md
# Check a configuration without printing values:  node scripts/check-config.js

# ---- Required ---------------------------------------------------------------
NODE_ENV=                      # production on a real server
PORT=                          # default 5051
SUPABASE_URL=
SUPABASE_KEY=                  # SERVICE-ROLE key — server only, never in a browser
ALLOWED_ORIGINS=               # comma-separated https origins (MCIS app, Nexus web console)
GEMINI_API_KEY=                # planner model for agent executions
GROQ_API_KEY=                  # loaded at start-up by legacy chat modules

# Firebase Admin (one of these options)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
# GOOGLE_APPLICATION_CREDENTIALS=
# FIREBASE_PROJECT_ID= / FIREBASE_CLIENT_EMAIL= / FIREBASE_PRIVATE_KEY=

# ---- Security switches (keep the defaults in production) ---------------------
SECURITY_FIREWALL_ENABLED=     # unset or true
PERMISSIONS_ENFORCED=          # true in production
WORKSPACE_INVITES_REQUIRE_VERIFIED_EMAIL=   # unset or true
WORKSPACE_DATA_SCOPING=        # unset (on)
# ALLOW_UNAUTHENTICATED_API — development only; ignored when NODE_ENV=production

# ---- Feature flags -----------------------------------------------------------
INTEGRATIONS_ENABLED=          # true to enable connectors
INTEGRATION_ENCRYPTION_KEY=    # required with integrations/webhooks: 32 random bytes (base64 or hex)
INTEGRATION_ENCRYPTION_KEY_ID=
WORKFLOWS_ENABLED=
REVENUE_SUITE_ENABLED=
REVENUE_WORKER_ENABLED=
BILLING_ENABLED=               # true = enforce plan limits; otherwise metering only
ONBOARDING_ENABLED=
TEMPLATES_ENABLED=
MULTI_INSTANCE_EXECUTION=      # true when running more than one backend instance

# ---- Payments (NOT CONFIGURED unless set) ------------------------------------
STRIPE_ENABLED=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
APP_BASE_URL=

# ---- Desktop execution bridge (Nexus engine) ---------------------------------
NEXUS_URL=                     # https (or loopback) URL of the Nexus api_server
NEXUS_DEVICE_TOKEN=            # must match nexus/.env

# ---- OAuth integrations ------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
GOOGLE_DRIVE_ENABLED=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# ---- Invitation email (optional; otherwise one-time codes) --------------------
INVITE_EMAIL_PROVIDER=         # resend | sendgrid
INVITE_EMAIL_API_KEY=
INVITE_EMAIL_FROM=

# ---- Operations --------------------------------------------------------------
PUBLIC_API_URL=
METRICS_TOKEN=                 # >= 32 chars; /metrics is disabled while unset
READINESS_REQUIRE_WORKERS=
RETENTION_SWEEP_MINUTES=
USAGE_RETENTION_DAYS=
APP_VERSION=
