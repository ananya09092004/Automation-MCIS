# Copy this file to .env and fill in real values. No secret VALUES are
# present in this file -- only the variable NAMES this backend reads
# (reconciled against actual runtime config: config/validateConfig.js,
# services/config/productionConfig.js / scripts/check-config.js, and a
# full `grep -r process.env` across the backend source, as of the C4
# security-hardening pass). See mcis/backend/docs/DEPLOYMENT.md and
# docs/PRODUCTION_CONFIG.md for what's required vs. optional, and what
# happens when something here is missing -- `node scripts/check-config.js`
# is the authoritative, automated version of that same check.
#
# This file is NOT yet claimed to cover every optional/internal flag in
# the codebase (dozens of third-party libraries read their own env vars
# too) -- it covers every variable THIS backend's own code reads.

# ---------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------
NODE_ENV=development
# Real default in code (server.js) is 5051, NOT 5000 -- match whatever
# you actually run behind. Most hosts (Render, Heroku, etc.) set PORT
# themselves; leave it unset there.
PORT=5051

# Comma-separated list of origins allowed to call this API with
# credentials (CORS). FRONTEND_URL is used as a single-origin fallback
# if ALLOWED_ORIGINS is unset. REQUIRED (one or the other) -- every
# origin must be an explicit https origin in production (no "*", no
# localhost).
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# This backend's own public URL, used when a route calls back into its
# own API (routes/chat.js's natural-language memory delete). Optional
# -- falls back to the hosted default if unset; set it explicitly for
# a self-hosted deployment.
BACKEND_URL=

# Explicit, logged, non-production-only escape hatch that disables
# Firebase auth entirely (see middleware/auth.js). NEVER set this in
# production -- every route becomes unauthenticated; it is IGNORED
# (never silently honoured) when NODE_ENV=production.
ALLOW_UNAUTHENTICATED_API=false

# ---------------------------------------------------------------------
# Security switches
# ---------------------------------------------------------------------
# Agent Firewall (services/security/agentFirewall.js) -- Layer 6 policy
# enforcement on every agent/connector action. Optional; defaults to
# on. Set "false" only to disable it; Layer 3 approvals still apply
# either way. Must be exactly "true" or "false" if set at all.
SECURITY_FIREWALL_ENABLED=true

# First-time resource approval for the desktop agent (security-engine/
# permissions.js): resources outside the small built-in SAFE_LIST need
# an explicit grant before a non-RED action can touch them. RED-tier
# actions are always blocked separately by backend-routing/riskModel.js
# regardless of this setting.
#
# REQUIRED to be set to exactly "true" or "false" in production --
# config/validateConfig.js refuses to start the server, and
# `node scripts/check-config.js` reports a fatal error, if this is
# unset or anything else in a production environment. This is
# deliberate: whether first-time approval is on is a real security
# decision, and an unset value must never silently decide it by
# omission.
#
# "false" is a legitimate, supported choice (not just a placeholder):
# the voice client does not yet re-send the original command after a
# grant, so turning this on breaks that flow until that UX is fixed
# (see docs/SECURITY_FIXES_PRE_LAYER2.md). Set "true" once that
# limitation no longer applies to your deployment, or if the desktop/
# browser-automation surface is what you need protected and voice is
# not in use.
PERMISSIONS_ENFORCED=false

# Layer 1: require a verified email before an invitation can be
# accepted. Optional; defaults to on (recommended). "false" disables it.
WORKSPACE_INVITES_REQUIRE_VERIFIED_EMAIL=true

# Layer 2: scope chat/memory/goals data to the selected workspace.
# Optional; defaults to on. "off" reverts to legacy (unscoped) behavior.
WORKSPACE_DATA_SCOPING=on

# Execution-ownership leases across backend instances (routes/ops.js,
# executionService.js). Optional; defaults to on. Set "false" ONLY if
# you run exactly one backend instance -- running more than one with
# this off risks two instances working the same execution.
MULTI_INSTANCE_EXECUTION=true

# ---------------------------------------------------------------------
# Supabase (primary datastore) -- REQUIRED. The service-role key, never
# the public/anon key (config/validateConfig.js refuses to start in
# production without both; services/config/productionConfig.js also
# flags an anon/authenticated-role key as invalid for this slot).
# ---------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_KEY=

# ---------------------------------------------------------------------
# Firebase Admin (auth) -- REQUIRED; one of these configuration styles
# is required -- see config/firebaseAdmin.js for exactly how they're
# tried, in this order.
# ---------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternative to the three vars above: a path to a service-account JSON
# file, or the JSON itself inline.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# ---------------------------------------------------------------------
# LLM / AI / search providers
# ---------------------------------------------------------------------
# Planner model for agent executions (backend-routing/taskPlanner.js,
# services/agentExecution). REQUIRED for agent/voice plan execution.
GEMINI_API_KEY=
# Loaded at start-up by legacy chat modules. REQUIRED (server fails to
# boot certain modules without it, even if your deployment does not
# use the legacy chat surface).
GROQ_API_KEY=
COHERE_API_KEY=
PINECONE_API_KEY=
PINECONE_HOST=
SERPER_API_KEY=

# ---------------------------------------------------------------------
# GitHub integration (OAuth connect + repo push)
# ---------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
# 32-byte (256-bit) key, base64 or hex, used to encrypt stored GitHub
# tokens at rest (security-engine/credentialEncryption.js). Generate
# with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key: see the rotation procedure documented at the top
# of security-engine/credentialEncryption.js. In short -- set the NEW
# key here, and put the OLD key in GITHUB_TOKEN_ENCRYPTION_KEY_PREVIOUS
# (comma-separated if more than one) so existing tokens keep decrypting
# during the rotation window.
GITHUB_TOKEN_ENCRYPTION_KEY=
GITHUB_TOKEN_ENCRYPTION_KEY_PREVIOUS=

# ---------------------------------------------------------------------
# Google OAuth (legacy Calendar/Docs-style integrations, if used --
# distinct from the Layer 5 Google Drive connector below)
# ---------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ---------------------------------------------------------------------
# Workspace integrations (Layer 5 connectors) -- services/integrations/
# ---------------------------------------------------------------------
# Master switch. Everything below in this section only has an effect
# when this is "true".
INTEGRATIONS_ENABLED=false
# 32-byte (256-bit) key, base64 or hex, that encrypts stored integration
# credentials (HTTP/Slack/email/Drive/GitHub connector secrets) at rest.
# REQUIRED whenever INTEGRATIONS_ENABLED=true or any webhook is created.
# Generate the same way as GITHUB_TOKEN_ENCRYPTION_KEY above.
INTEGRATION_ENCRYPTION_KEY=
# Key-ring id for the CURRENT key above (defaults to "k1" if unset).
INTEGRATION_ENCRYPTION_KEY_ID=
# Rotation: "<old_id>:<old_key>,<old_id2>:<old_key2>,..." -- old keys
# kept only long enough to run scripts/rotate-integration-keys.js, then
# removed. An old key must NOT reuse the current key's id.
INTEGRATION_ENCRYPTION_OLD_KEYS=

# Google Drive connector (needs INTEGRATIONS_ENABLED=true too).
GOOGLE_DRIVE_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# ---------------------------------------------------------------------
# Billing (Layer 7/8) -- services/billing/, routes/billing.js. A real
# usage ledger, plan catalogue and entitlement service exist regardless
# of this switch; BILLING_ENABLED decides whether plan limits are
# ENFORCED (usage is always metered either way). See
# docs/LAYER7_BILLING.md and docs/LAYER8_CUSTOMER.md.
# ---------------------------------------------------------------------
BILLING_ENABLED=false
# Grace period (days) before a past_due subscription's plan lapses to
# Free. Optional; see services/billing for the default if unset.
BILLING_PAST_DUE_GRACE_DAYS=
# Non-Stripe provider path: "generic" accepts signed webhooks from any
# provider under that shared-secret scheme (see services/billing/
# providers.js). Leave unset / "none" if only Stripe (or nothing) is
# used.
BILLING_PROVIDER=
# Required only when BILLING_PROVIDER=generic (and STRIPE_ENABLED is
# not "true"): shared secret (32+ chars) used to verify those webhooks.
BILLING_WEBHOOK_SECRET=

# Stripe, specifically -- set STRIPE_ENABLED=true to make Stripe the
# active provider (takes priority over BILLING_PROVIDER above).
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
# Signing secret of POST /api/billing/webhooks/stripe.
STRIPE_WEBHOOK_SECRET=
# One Stripe price id per paid plan you offer, e.g.:
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_BUSINESS=
# STRIPE_PRICE_ENTERPRISE=   (Enterprise is normally activated
#   manually by an operator -- see scripts/billing-set-plan.js -- but
#   online checkout is offered too if its price id is set here.)

# Web app URL used for Stripe Checkout / customer-portal return links,
# and for invitation-email links below. Required wherever either of
# those features is used.
APP_BASE_URL=

# ---------------------------------------------------------------------
# Invitation emails (optional -- without this, invitations are shared
# as one-time codes with no email sent). services/invitationMailer.js.
# ---------------------------------------------------------------------
INVITE_EMAIL_PROVIDER=
INVITE_EMAIL_API_KEY=
# Must be a sender address verified with the chosen provider.
INVITE_EMAIL_FROM=

# ---------------------------------------------------------------------
# Media
# ---------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------
# Code execution sandbox (Judge0) -- see services/sandboxService.js.
# All submitted-code execution now goes through this, never the host.
# ---------------------------------------------------------------------
JUDGE0_API_HOST=
JUDGE0_API_KEY=

# ---------------------------------------------------------------------
# Nexus (voice/desktop automation bridge)
# ---------------------------------------------------------------------
NEXUS_URL=http://127.0.0.1:8000
# REQUIRED whenever NEXUS_URL is set: the shared secret the Nexus HTTP
# bridge (nexus/api_server.py) and this backend both use to authenticate
# bridge calls -- see nexus/.env.example for the matching value on that
# side. Must be https (or loopback) in production, since this token
# would otherwise travel in clear text.
NEXUS_DEVICE_TOKEN=
# Shared secret the local voice device uses against THIS backend's
# voice-device auth path (security-engine/callerIdentity.js) -- a
# different credential from NEXUS_DEVICE_TOKEN above (that one is
# backend<->Nexus bridge; this one is voice-client<->backend).
NEXUS_VOICE_DEVICE_TOKEN=
# Rotation: put the OLD token here (comma-separated if more than one)
# while rotating NEXUS_VOICE_DEVICE_TOKEN, so an already-paired device
# isn't locked out until it's re-paired with the new one.
NEXUS_VOICE_DEVICE_TOKEN_PREVIOUS=
# Revocation: comma-separated deviceId values to block even when the
# shared secret presented alongside them is otherwise valid -- use this
# to shut off one specific compromised/lost physical device without
# rotating NEXUS_VOICE_DEVICE_TOKEN for every other device that shares
# it. deviceId is a client-asserted label (never a security boundary on
# its own), so this only helps once you know the specific id to block --
# full compromise of the shared secret itself still requires rotation.
NEXUS_VOICE_DEVICE_REVOKED_IDS=

# ---------------------------------------------------------------------
# Product feature flags (all optional; default shown is the shipped
# default when unset)
# ---------------------------------------------------------------------
ONBOARDING_ENABLED=true
TEMPLATES_ENABLED=true
WORKFLOWS_ENABLED=true
# Layer 10: competitor intelligence, monitoring, alerts, agent QA,
# webhooks.
REVENUE_SUITE_ENABLED=true
# Scheduled checks / QA runs / webhook deliveries on THIS instance.
# Set "false" on extra instances if you intentionally want only one
# instance running these (they are safe to run on several, though).
REVENUE_WORKER_ENABLED=true
WORKFLOW_WORKER_ENABLED=true

# ---------------------------------------------------------------------
# Rate limiting / quotas (legacy chat daily limit -- separate from the
# Layer 7 billing plan limits above; see docs/BILLING.md)
# ---------------------------------------------------------------------
DAILY_MESSAGE_LIMIT=300
DAILY_MESSAGE_LIMIT_PRO=1000
MAX_MEMORIES_PER_USER=

# ---------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------
# Bearer token for GET /metrics (at least 32 characters). Optional --
# /metrics is disabled entirely until this is set.
METRICS_TOKEN=
# Days of usage ledger to keep (35-3650). Optional.
USAGE_RETENTION_DAYS=
# Minutes between retention sweeps (0 = off, minimum 5). Optional.
RETENTION_SWEEP_MINUTES=
# Readiness probe (/health/ready) requires at least one live worker
# when "true". Optional.
READINESS_REQUIRE_WORKERS=
PUBLIC_API_URL=
# Max time (ms) a graceful SIGTERM/SIGINT shutdown is given to finish
# in-flight requests and release workflow/revenue-worker leases before
# the process force-exits anyway (config/gracefulShutdown.js). Optional
# -- defaults to 10000 (10s) if unset.
SHUTDOWN_TIMEOUT_MS=10000

# ---------------------------------------------------------------------
# Error monitoring (optional -- see config/sentry.js)
# ---------------------------------------------------------------------
# Leaving this unset is a fully supported, intentional configuration:
# Sentry stays completely disabled (no external calls, nothing to
# configure) in dev/test. Only set this with a real Sentry DSN in a
# deployment that actually wants error reporting.
SENTRY_DSN=
