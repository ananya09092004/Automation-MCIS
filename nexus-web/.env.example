# Nexus web console — copy to .env.local and fill in. NEVER put server secrets here:
# everything prefixed VITE_ is shipped to the browser.

# Backend origin in production (e.g. https://api.example.com). Leave empty in
# development: Vite proxies /api to NEXUS_DEV_API_TARGET.
VITE_API_URL=
# Dev only (not shipped): where the dev server proxies /api. Default http://localhost:5051
NEXUS_DEV_API_TARGET=

# Firebase Web app config (the SAME Firebase project the backend verifies
# tokens for). These are public client identifiers, not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
