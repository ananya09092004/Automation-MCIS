# Copy to .env (next to api_server.py) and fill in real values. No
# secret VALUES are present here -- only the variable names api_server.py
# actually reads.

# Shared secret the MCIS Node.js backend sends as X-Device-Token on
# every /execute and /queue-status request. Leaving this UNSET means
# every request is refused (fail-closed) -- see api_server.py's
# verify_token(). This is the single most important thing to set
# before running this bridge anywhere reachable from outside your own
# machine.
NEXUS_DEVICE_TOKEN=

# Local-development-ONLY escape hatch: with NEXUS_DEVICE_TOKEN unset,
# setting this to "true" restores the old permissive (unauthenticated)
# behavior. Never set this on a machine reachable from outside
# localhost -- every /execute request is accepted from anyone who can
# reach the port.
NEXUS_ALLOW_UNSAFE_DEV=false

# Host this HTTP bridge binds to when run directly (python api_server.py).
# Defaults to 127.0.0.1 (localhost-only) if unset. Binding to anything
# else without NEXUS_DEVICE_TOKEN set is refused outright at startup.
NEXUS_BIND_HOST=127.0.0.1
NEXUS_PORT=8000
